# Kopieren nach .env und ausfüllen. Bun lädt .env automatisch aus dem Arbeitsverzeichnis.
# Eine Quelle ohne URL wird einfach übersprungen (z. B. erst nur ADO einrichten).

# --- Jira Data Center -------------------------------------------------------
JIRA_BASE_URL=https://jira.firma.at
# Profil → Personal Access Tokens (ab Jira DC 8.14)
JIRA_PAT=
JIRA_JQL=sprint in openSprints() AND assignee = currentUser() ORDER BY updated DESC
# Nur diese Projekt-Keys in Branch/PR-Titel erkennen (verhindert Treffer wie "UTF-8")
JIRA_PROJECT_KEYS=ABC
# Status, in denen ein Ticket nach dem Merge stehen darf, ohne dass ein Hinweis kommt
JIRA_POST_MERGE_STATUSES=In Test,Testing,Ready for Test,Done,Closed,Resolved

# --- Azure DevOps -----------------------------------------------------------
# Cloud: https://dev.azure.com/<org>   On-Prem: https://tfs.firma.at/<collection>
ADO_ORG_URL=https://dev.azure.com/meine-org
ADO_PROJECT=MeinProjekt
# PAT mit Scope "Code (Read)"
ADO_PAT=
ADO_API_VERSION=7.1
# Optional: eigene User-ID, falls _apis/connectionData nicht erreichbar ist
ADO_USER_ID=
# Wie weit zurück gemergte PRs für "Ticket weiterschieben?" berücksichtigt werden
ADO_MERGED_LOOKBACK_DAYS=14

# --- Live-Server (bun run serve / Docker) ------------------------------------
# Wie oft Jira/ADO abgefragt werden; neue Stände gehen sofort per WebSocket an offene Tabs
POLL_SECONDS=120
PORT=3000
# 127.0.0.1 = nur von diesem Rechner erreichbar (in Docker wird das in compose.yaml überschrieben)
HOST=127.0.0.1

# --- Dashboard ---------------------------------------------------------------
OUT_DIR=./out
CHANGES_KEEP_HOURS=48
# Nur für den statischen Modus (bun run start / loop): Reload-Intervall der HTML-Datei
REFRESH_SECONDS=300
# Nur für "bun run loop" (Alternative zu Cron)
LOOP_MINUTES=5
