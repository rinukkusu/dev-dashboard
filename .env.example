# Copy to .env and fill in. Bun loads .env from the working directory automatically.
# A source is on as soon as its token is set – leave a token empty to switch the source off.

# --- Jira Data Center -------------------------------------------------------
# Profile → Personal Access Tokens (Jira DC 8.14+)
JIRA_PAT=
JIRA_BASE_URL=https://jira.example.com
# The "Tickets" list
JIRA_JQL=sprint in openSprints() AND assignee = currentUser() ORDER BY updated DESC
# Other tickets you get updates for. You become a watcher when you comment, so this covers
# "everything I commented on". Empty = off.
JIRA_INVOLVED_JQL=watcher = currentUser() AND updated >= -14d ORDER BY updated DESC
# Only detect these project keys in branch names / PR titles (avoids matches like "UTF-8")
JIRA_PROJECT_KEYS=ABC
# Kanban columns come from your Jira Software board (same columns, same order). The board is found
# via the projects of your sprint tickets; set ids here to pick specific boards instead.
JIRA_BOARD_IDS=
# Only without a board (no Jira Software): column order by status name, e.g. To Do,In Arbeit,In Review,In Test,Done
# Statuses not listed are sorted by category (to do → in progress → done).
JIRA_STATUS_ORDER=
# Statuses a ticket may be in after its PR is merged without getting a "move it on?" hint
JIRA_POST_MERGE_STATUSES=In Test,Testing,Ready for Test,Done,Closed,Resolved

# --- Azure DevOps -----------------------------------------------------------
# PAT with scopes "Code (Read)" and "Build (Read)"
ADO_PAT=
# Cloud: https://dev.azure.com/<org>   On-prem: https://tfs.example.com/<collection>
ADO_ORG_URL=https://dev.azure.com/my-org
# One project or several, comma-separated (PRs and builds are fetched per project)
ADO_PROJECT=MyProject
ADO_API_VERSION=7.1
# Optional: your own user ID, if _apis/connectionData isn't reachable
ADO_USER_ID=
# How far back merged PRs count for "ticket still not moved on?"
ADO_MERGED_LOOKBACK_DAYS=14
# ADO can't search for "PRs I commented on", so the dashboard looks through the project's
# active PRs this often (minutes) and then follows the ones it found. 0 = off.
ADO_DISCOVER_MINUTES=15

# --- GitHub.com ---------------------------------------------------------------
# Classic token with "repo" (or fine-grained: Pull requests, Issues, Actions, Metadata – read)
GITHUB_TOKEN=

# --- GitHub Enterprise Server -------------------------------------------------
GHE_TOKEN=
GHE_URL=https://github.example.com
# Name shown in error messages
GHE_LABEL=GitHub Enterprise

# Both GitHubs: how far back PRs/issues you're involved in (commented, mentioned, reviewed) count
GITHUB_LOOKBACK_DAYS=14

# --- Live server (bun run serve / Docker) -----------------------------------
# How often all sources get polled; new states go to open tabs right away over a WebSocket
POLL_SECONDS=120
# The dashboard is reachable on this port (with Docker too)
PORT=3000
# 127.0.0.1 = only reachable from this machine (Docker overrides this in compose.yaml)
HOST=127.0.0.1

# --- herdr (optional, live server only) --------------------------------------
# Socket from `herdr status server`; tcp://host.docker.internal:7377 for Docker + herdr on Windows
# (then run `bun run herdr-bridge` on Windows). Empty = off.
HERDR_SOCKET=
# How often agent states are fetched
HERDR_POLL_SECONDS=3
# Claude Code transcripts for the chat view (default ~/.claude/projects; in Docker see compose.yaml)
CLAUDE_PROJECTS_DIR=

# --- Dashboard ---------------------------------------------------------------
# UI language: en or de. In the live server each browser can switch in the header.
DASHBOARD_LANG=en
OUT_DIR=./out
CHANGES_KEEP_HOURS=48
# CI runs (yours and watched ones) are listed this long
RUNS_KEEP_HOURS=24
# Static mode only (bun run start / loop): reload interval of the HTML file
REFRESH_SECONDS=300
# Only for "bun run loop" (alternative to cron)
LOOP_MINUTES=5
